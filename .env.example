# Copie para .env e preencha os dados de Supabase > Connect > Session pooler.
SUPABASE_DB_HOST=SEU_HOST.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD='COLOQUE_A_SENHA_DO_BANCO_AQUI'

# Alternativa aos campos acima; tem prioridade quando preenchida.
# DATABASE_URL='postgresql://postgres.SEU_PROJECT_REF:SENHA_CODIFICADA@SEU_HOST.pooler.supabase.com:5432/postgres'

